{
  "expo": {
    "name": "NarcoLens",
    "slug": "narcolens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "narcolens",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.narcolens.field",
      "adaptiveIcon": {
        "backgroundColor": "#1B1C1F",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NarcoLens uses the camera to photograph the reagent plate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NarcoLens reads a plate photo you already took."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NarcoLens records where a field test was done."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "",
      "router": {},
      "eas": {
        "projectId": "60aa9347-9aee-44dc-9850-02357ab0045a"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "akizhere_08"
  }
}
